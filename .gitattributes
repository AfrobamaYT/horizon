# Generated files that tests compare byte for byte with what they generate: LF on every OS, also
# where Git for Windows' core.autocrlf would check them out with CRLF.
docs/launcher-commands.md text eol=lf
docs/horizon-ctl-commands.md text eol=lf
crates/horizon-theme/tokens.css text eol=lf
docs/api/*-reference.md text eol=lf
# Generated by `cargo run -p xtask -- mod-api`; `--check` compares them byte for byte. With the merge driver set
# (git config merge.mod-api-generated.driver true), a merge keeps this branch's copy instead of conflicting; run
# `cargo run -p xtask -- mod-api` after the merge to regenerate them.
crates/horizon-client/src/mod_api/generated.rs linguist-generated=true text eol=lf merge=mod-api-generated
crates/horizon-client/src/mod_api/generated_host.rs linguist-generated=true text eol=lf merge=mod-api-generated
crates/horizon-client/src/game/mod_api_host_generated.rs linguist-generated=true text eol=lf merge=mod-api-generated
crates/horizon-client-render/src/gfx/native_render/generated.rs linguist-generated=true text eol=lf merge=mod-api-generated
