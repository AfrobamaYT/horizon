//! Per-library entry module generated by the launcher.
macro_rules! native_mods {
    ($($id:literal => $hooks:path,)*) => {
        vec![$(mod_api::ModEntry::new($id, $hooks()),)*]
    };
}

#[inline(never)]
pub fn entries() -> Vec<mod_api::ModEntry> {
    native_mods! {
    /* MOD_ENTRIES */
    }
}

#[inline(never)]
pub fn slots() -> Vec<mod_api::__private::points::SlotListener> {
    vec![
/* MOD_SLOTS */
    ]
}

fn installs() -> Vec<(&'static str, &'static [&'static str], bool)> {
    vec![
/* MOD_REDIRECTS */
    ]
}
static MOD: mod_api::__private::native::NativeMod = mod_api::__private::native::NativeMod {
    entries, slots, installs,
    built: &[
/* BUILT_MODS */
    ],
};
#[unsafe(no_mangle)]
pub extern "C" fn horizon_native_build() -> *const core::ffi::c_char {
    c"/* NATIVE_BUILD */".as_ptr()
}
#[unsafe(no_mangle)]
pub fn horizon_native_mod_v1() -> &'static mod_api::__private::native::NativeMod { &MOD }
