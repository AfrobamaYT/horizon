{
  "hooks": [
    {
      "name": "entity_multi_place",
      "target": "horizon_client::game::native_hooks::Game<'_>::native_entity_multi_place",
      "neoforge": "BlockEvent.EntityMultiPlaceEvent",
      "side": "both",
      "cancellable": true,
      "mod_api": {
        "contract": "cancel",
        "out": "cancel"
      }
    }
  ],
  "rust_summary": "an entity placing multiple blocks (`native_entity_multi_place`).",
  "doc_summary": "`native_entity_multi_place(state, snapshots, cancel)` hears a multi-block placement. Set `cancel` to prevent it. Bundles need \"hooks\": @API:entity_multi_place@."
}
